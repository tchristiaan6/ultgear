---
import '../styles/global.css';
import { site } from '../lib/data';
const { title, description = "ULT Gear: a one-person ultralight travel gear lab, 2023 to 2024. Tech packs, factory samples, prototypes, and what it cost.", image = site.hero.image, type = 'website' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{ label: 'Clothing', href: '/#clothing' }, { label: 'Bags', href: '/#bags' }, { label: 'Products', href: '/#physical' }, { label: 'Technical', href: '/#technical' }, { label: 'SwitchKicks', href: '/#switchkicks' }, { label: 'The store', href: '/#storefront' }];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} | ULT Gear` : 'ULT Gear | Ultra-light travel gear for the modern explorer'}</title>
<meta name="description" content={description}><link rel="canonical" href={canonical}>
<link rel="icon" href={site.brand.mark_dark} type="image/png">
<meta property="og:type" content={type}><meta property="og:site_name" content="ULT Gear"><meta property="og:title" content={title || 'ULT Gear'}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<div class="archive-bar">ULT Gear is a retired project, 2023 to 2024. Nothing here is for sale. A <a href="https://tchristiaan.com" target="_blank" rel="noopener">TChristiaan</a> project by Thomas Bouwman.</div>
<header class="header"><div class="container">
  <a class="brand" href="/"><img src={site.brand.mark_dark} alt="" width="34" height="34"><span>ULT<b>GEAR</b></span></a>
  <nav class="nav" aria-label="Main">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
</div></header>
<main><slot /></main>
<footer class="footer"><div class="container">
  <div class="top"><img src={site.brand.mark_light} alt="ULT Gear"><p>Ultra-light travel gear for the modern explorer. A product lab that ran from 2023 to 2024 out of Denver, Colorado, and stopped when the invoices for molds and minimum orders came in.</p></div>
  <div class="bottom"><span>© 2023–2024 ULT Gear LLC. Archived 2026.</span><span>A <a href="https://tchristiaan.com">TChristiaan</a> project by Thomas Bouwman</span></div>
</div></footer>
<script>
  const els=[...document.querySelectorAll('.reveal')];
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});els.forEach(e=>e.getBoundingClientRect().top<innerHeight?e.classList.add('in'):io.observe(e))}else els.forEach(e=>e.classList.add('in'));
</script>
</body></html>
